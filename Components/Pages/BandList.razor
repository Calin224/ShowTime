@page "/band-list"
@using STime.Entities
@using STime.Enums
@using STime.Interfaces
@inject IRepositoryBand repo
@inject NavigationManager navigationManager

<div class="min-h-screen bg-gradient-to-br from-purple-50 to-indigo-100 py-12 px-4">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Band Collection</h1>
            <p class="text-gray-600">Manage your music band collection</p>
        </div>

        <div class="mb-6 flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="bg-white rounded-xl px-4 py-2 shadow-sm">
                    <span class="text-sm font-medium text-gray-600">Total Bands: </span>
                    <span class="text-sm font-bold text-purple-600">@Bands.Count</span>
                </div>
            </div>

            <a href="/add-band"
               class="inline-flex items-center bg-gradient-to-r from-purple-500 to-indigo-600 text-white font-semibold py-3 px-6 rounded-xl hover:from-purple-600 hover:to-indigo-700 focus:outline-none focus:ring-4 focus:ring-purple-500/50 transform hover:scale-[1.02] transition-all duration-200 shadow-lg hover:shadow-xl">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Add New Band
            </a>
        </div>

        @if (Bands.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
                <div class="p-12 text-center">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-full mb-6">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">No bands yet</h3>
                    <p class="text-gray-600 mb-6">Start building your collection by adding your first band!</p>
                    <a href="/add-band"
                       class="inline-flex items-center bg-gradient-to-r from-purple-500 to-indigo-600 text-white font-semibold py-3 px-6 rounded-xl hover:from-purple-600 hover:to-indigo-700 focus:outline-none focus:ring-4 focus:ring-purple-500/50 transform hover:scale-[1.02] transition-all duration-200 shadow-lg hover:shadow-xl">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        Add Your First Band
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
                <div class="p-6">
                    <MudDataGrid Items="@Bands"
                                 Hover="true"
                                 Striped="true"
                                 Dense="false"
                                 class="mud-table-root">
                        <Columns>
                            @if (!edit)
                            {
                                <PropertyColumn Property="x => x.Id"
                                                Title="ID"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex items-center">
                                            <div
                                                class="w-8 h-8 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
                                                @context.Item.Id
                                            </div>
                                        </div>
                                    </CellTemplate>
                                </PropertyColumn>

                                <PropertyColumn Property="x => x.Name"
                                                Title="Band Name"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex items-center">
                                            <div
                                                class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mr-3">
                                                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor"
                                                     viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="font-semibold text-gray-900">@context.Item.Name</div>
                                            </div>
                                        </div>
                                    </CellTemplate>
                                </PropertyColumn>

                                <PropertyColumn Property="x => x.Genre"
                                                Title="Genre"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div
                                            class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gradient-to-r from-purple-100 to-indigo-100 text-purple-800">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M7 4V2a1 1 0 011-1h4a1 1 0 011 1v2h4a1 1 0 011 1v2a1 1 0 01-1 1h-1v9a2 2 0 01-2 2H6a2 2 0 01-2-2V8H3a1 1 0 01-1-1V5a1 1 0 011-1h4z"></path>
                                            </svg>
                                            @context.Item.Genre
                                        </div>
                                    </CellTemplate>
                                </PropertyColumn>
                                
                                <TemplateColumn Title="Actions"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex space-x-2">
                                            <button @onclick="() => edit = !edit"
                                                    class="inline-flex items-center p-2 text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </button>
                                            <button @onclick="() => DeleteBand(context.Item.Id)"
                                                    class="inline-flex items-center p-2 text-red-600 hover:text-red-800 hover:bg-red-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1-1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                            else{
                                <PropertyColumn Property="x => x.Id"
                                                Title="ID"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex items-center">
                                            <div
                                                class="w-8 h-8 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
                                                @context.Item.Id
                                            </div>
                                        </div>
                                    </CellTemplate>
                                </PropertyColumn>
                                
                                <PropertyColumn Property="x => x.Name"
                                                Title="Band Name"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex items-center">
                                            <div
                                                class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mr-3">
                                                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor"
                                                     viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                </svg>
                                            </div>
                                            <div>
                                                @* <div class="font-semibold text-gray-900">@context.Item.Name</div> *@
                                                <MudTextField @bind-Value="@context.Item.Name" Immediate="true"></MudTextField>
                                            </div>
                                        </div>
                                    </CellTemplate>
                                </PropertyColumn>
                                
                                <PropertyColumn Property="x => x.Genre"
                                                Title="Genre"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <MudSelect T="Genre" 
                                                   @bind-Value="@context.Item.Genre"
                                                   Label="Select genre"
                                                   Variant="Variant.Outlined"
                                                   Class="w-full"
                                                   Style="--mud-palette-primary: #8b5cf6;">
                                            @foreach (Genre state in Enum.GetValues(typeof(Genre)))
                                            {
                                                <MudSelectItem T="Genre" Value="@state">@state</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </CellTemplate>
                                </PropertyColumn>
                                
                                <TemplateColumn Title="Save Changes">
                                    <CellTemplate>
                                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   @onclick="SaveBandChanges">Save
                                        </MudButton>
                                    </CellTemplate>
                                </TemplateColumn>
                                
                                <TemplateColumn Title="Actions"
                                                HeaderStyle="background-color: #f8fafc; font-weight: 600; color: #374151;">
                                    <CellTemplate>
                                        <div class="flex space-x-2">
                                            <button @onclick="() => edit = !edit"
                                                    class="inline-flex items-center p-2 text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </button>
                                            <button @onclick="() => DeleteBand(context.Item.Id)"
                                                    class="inline-flex items-center p-2 text-red-600 hover:text-red-800 hover:bg-red-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1-1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                        </Columns>
                    </MudDataGrid>
                </div>
            </div>
        }

        @if (showError)
        {
            <div class="mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-red-800 font-medium">Error loading bands. Please try again.</p>
                </div>
            </div>
        }
        
        @if (showEditSuccess)
        {
            <div class="mt-6 bg-green-50 border border-green-200 rounded-xl p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-green-800 font-medium">Band updated successfully!</p>
                </div>
            </div>
        }

        @if (showDeleteSuccess)
        {
            <div class="mt-6 bg-green-50 border border-green-200 rounded-xl p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-green-800 font-medium">Band deleted successfully!</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    IReadOnlyList<Band> Bands = [];
    private bool showError = false;
    private bool showDeleteSuccess = false;
    private bool showEditSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBands();
    }

    private async Task LoadBands()
    {
        try
        {
            showError = false;
            Bands = await repo.ListAllAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bands: {ex.Message}");
            showError = true;
            StateHasChanged();
        }
    }

    private bool edit = false;

    private void EditBand()
    {
        edit = true;
    }

    private async Task DeleteBand(int bandId)
    {
        try
        {
            var bandToDelete = await repo.GetByIdAsync(bandId);
            if (bandToDelete != null)
            {
                repo.Delete(bandToDelete);
                if (await repo.SaveAsync())
                {
                    showDeleteSuccess = true;
                    await LoadBands();
                    
                    await Task.Delay(3000);
                    showDeleteSuccess = false;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting band: {ex.Message}");
            showError = true;
            StateHasChanged();
        }
    }

    private async Task SaveBandChanges()
    {
        await repo.SaveAsync();

        showEditSuccess = true;
        await Task.Delay(500);
        edit = false;
        showEditSuccess = false;
    }

}