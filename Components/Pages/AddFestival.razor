@page "/add-festival"
@using STime.Entities
@using STime.Interfaces

@inject IRepositoryFestival repo
@inject NavigationManager navigationManager
@inject IRepositoryBand repoBand
@inject IPhotoService photoService

<div class="min-h-screen bg-gradient-to-br from-purple-50 to-indigo-100 py-12 px-4">
    <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Add New Festival</h1>
            <p class="text-gray-600">Create a new music festival event</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="p-8">
                <MudForm Model="@Festival">
                    <div class="space-y-6">
                        <div class="border-b border-gray-200 pb-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                Basic Information
                            </h3>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Festival Name</label>
                                    <MudTextField @bind-Value="Festival.Name" 
                                                  Immediate="true"
                                                  Label="Enter festival name"
                                                  Variant="Variant.Outlined"
                                                  Class="w-full"
                                                  Style="--mud-palette-primary: #8b5cf6;"></MudTextField>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Location</label>
                                    <MudTextField @bind-Value="Festival.Location"
                                                  Immediate="true"
                                                  Label="Enter location"
                                                  Variant="Variant.Outlined"
                                                  Class="w-full"
                                                  Style="--mud-palette-primary: #8b5cf6;"></MudTextField>
                                </div>
                            </div>
                            
                            <div class="mt-6">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                                <MudTextField @bind-Value="Festival.Description"
                                              Immediate="true"
                                              Label="Enter festival description"
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Class="w-full"
                                              Style="--mud-palette-primary: #8b5cf6;"></MudTextField>
                            </div>
                        </div>

                        <!-- Date Selection Section -->
                        <div class="border-b border-gray-200 pb-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                Event Dates
                            </h3>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Start Date</label>
                                    <MudDatePicker @bind-Date="Festival.StartDate" 
                                                   Label="Select start date"
                                                   Variant="Variant.Outlined"
                                                   Class="w-full"
                                                   Style="--mud-palette-primary: #8b5cf6;" />
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">End Date</label>
                                    <MudDatePicker @bind-Date="Festival.EndDate" 
                                                   Label="Select end date"
                                                   Variant="Variant.Outlined"
                                                   Class="w-full"
                                                   Style="--mud-palette-primary: #8b5cf6;" />
                                </div>
                            </div>
                        </div>

                        <div class="border-b border-gray-200 pb-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                Festival Image
                                @if (isUploading)
                                {
                                    <div class="ml-2 flex items-center">
                                        <svg class="animate-spin h-4 w-4 text-purple-600" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span class="ml-1 text-sm text-purple-600">Uploading...</span>
                                    </div>
                                }
                            </h3>
                            
                            @if (!string.IsNullOrEmpty(Festival.Url))
                            {
                                <div class="mb-4 relative">
                                    <img src="@Festival.Url" alt="Festival preview" class="w-full h-48 object-cover rounded-lg shadow-md">
                                    <div class="absolute top-2 right-2">
                                        <button @onclick="RemoveImage" 
                                                class="bg-red-500 hover:bg-red-600 text-white rounded-full p-2 shadow-lg transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="absolute bottom-2 left-2 bg-black bg-opacity-50 text-white px-2 py-1 rounded text-sm">
                                        ✓ Image uploaded successfully
                                    </div>
                                </div>
                            }
                            
                            <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-purple-400 transition-colors @(isUploading ? "opacity-50" : "")">
                                <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Disabled="@isUploading">
                                    <ActivatorContent>
                                        <div class="space-y-2">
                                            @if (!isUploading)
                                            {
                                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="animate-spin mx-auto h-12 w-12 text-purple-600" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                            }
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                                       Disabled="@isUploading"
                                                       Class="bg-gradient-to-r from-purple-500 to-indigo-600 text-white">
                                                @(string.IsNullOrEmpty(Festival.Url) ? "Upload Festival Image" : "Change Image")
                                            </MudButton>
                                            <p class="text-sm text-gray-500">PNG, JPG, GIF up to 10MB</p>
                                            @if (!string.IsNullOrEmpty(uploadedFileName))
                                            {
                                                <p class="text-sm text-green-600">✓ @uploadedFileName</p>
                                            }
                                        </div>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </div>
                        </div>

                        <div class="pb-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                                <svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                                Festival Lineup
                            </h3>
                            
                            @if (availableBands != null && availableBands.Any())    
                            {
                                <div class="flex space-x-4 mb-4">
                                    <div class="flex-1">
                                        <MudSelect T="int" 
                                                   Label="Add Band to Lineup" 
                                                   @bind-Value="selectedBandId" 
                                                   Placeholder="Choose a band to add"
                                                   Variant="Variant.Outlined"
                                                   Style="--mud-palette-primary: #8b5cf6;">
                                            @foreach (var band in availableBands.Where(b => !selectedBands.Contains(b.Id)))
                                            {
                                                <MudSelectItem Value="@band.Id">@band.Name (@band.Genre)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                    
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Primary" 
                                               @onclick="AddBandToFestival"
                                               Disabled="@(selectedBandId == 0)"
                                               Class="mt-2 bg-gradient-to-r from-purple-500 to-indigo-600">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                        </svg>
                                        Add Band
                                    </MudButton>
                                </div>
                            }
                            
                            @if (selectedBands.Any())
                            {
                                <div class="bg-gray-50 rounded-xl p-4">
                                    <h4 class="font-medium text-gray-900 mb-3">Selected Bands (@selectedBands.Count)</h4>
                                    <div class="space-y-2">
                                        @foreach (var bandId in selectedBands)
                                        {
                                            var band = availableBands?.FirstOrDefault(b => b.Id == bandId);
                                            if (band != null)
                                            {
                                                <div class="flex items-center justify-between bg-white p-3 rounded-lg shadow-sm">
                                                    <div class="flex items-center">
                                                        <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full flex items-center justify-center mr-3">
                                                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                            </svg>
                                                        </div>
                                                        <div>
                                                            <div class="font-medium text-gray-900">@band.Name</div>
                                                            <div class="text-sm text-gray-500">@band.Genre</div>
                                                        </div>
                                                    </div>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                   Color="Color.Error" 
                                                                   Size="Size.Small"
                                                                   Class="text-red-500 hover:bg-red-50"
                                                                   @onclick="() => RemoveBandFromFestival(bandId)" />
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-8 text-gray-500">
                                    <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                    <p>No bands selected yet. Add some bands to create your lineup!</p>
                                </div>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex justify-between items-center pt-6 border-t border-gray-200">
                            <a href="/festivals"
                               class="inline-flex items-center text-gray-600 hover:text-gray-800 font-medium py-2 px-4 rounded-lg hover:bg-gray-100 transition-colors">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                </svg>
                                Back to Festivals
                            </a>

                            <MudButton Variant="Variant.Filled" 
                                       @onclick="AddFestivalEvent"
                                       Class="inline-flex items-center bg-gradient-to-r from-purple-500 to-indigo-600 text-white font-semibold py-3 px-8 rounded-xl hover:from-purple-600 hover:to-indigo-700 focus:outline-none focus:ring-4 focus:ring-purple-500/50 transform hover:scale-[1.02] transition-all duration-200 shadow-lg hover:shadow-xl"
                                       Style="background: linear-gradient(135deg, #8b5cf6 0%, #4f46e5 100%); text-transform: none;">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                </svg>
                                Create Festival
                            </MudButton>
                        </div>
                    </div>
                </MudForm>
            </div>
        </div>

        @if (showSuccess)
        {
            <div class="mt-6 bg-green-50 border border-green-200 rounded-xl p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-green-800 font-medium">Festival added successfully!</p>
                </div>
            </div>
        }

        @if (showError)
        {
            <div class="mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-red-800 font-medium">Error adding festival. Please try again.</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    public Festival Festival { get; set; } = new Festival()
    {
        Location = string.Empty,
        Name = string.Empty,
        Description = string.Empty,
        StartDate = null,
        EndDate = null
    };

    private bool showSuccess = false;
    private bool showError = false;
    private bool isUploading = false;
    private string uploadedFileName = string.Empty;
    private IReadOnlyList<Band>? availableBands;
    private List<int> selectedBands = new List<int>();
    private int selectedBandId = 0;

    protected override async Task OnInitializedAsync()
    {
        availableBands = await repoBand.ListAllAsync();
    }

    private void AddBandToFestival()
    {
        if (selectedBandId > 0 && !selectedBands.Contains(selectedBandId))
        {
            selectedBands.Add(selectedBandId);
            selectedBandId = 0;
            StateHasChanged();
        }   
    }

    private void RemoveBandFromFestival(int bandId)
    {
        selectedBands.Remove(bandId);
        StateHasChanged();
    }

    private async Task UploadFiles(IBrowserFile? file)
    {
        if (file == null) return;
        
        try
        {
            isUploading = true;
            uploadedFileName = file.Name;
            StateHasChanged();
            
            var results = await photoService.AddPhotosAsync(file);
            foreach (var result in results)
            {
                Festival.Url = result.SecureUrl.AbsoluteUri;
                Festival.PublicId = result.PublicId;
            }
            
            isUploading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading file: {ex.Message}");
            isUploading = false;
            showError = true;
            StateHasChanged();
        }
    }

    private void RemoveImage()
    {
        Festival.Url = string.Empty;
        Festival.PublicId = string.Empty;
        uploadedFileName = string.Empty;
        StateHasChanged();
    }

    private async Task AddFestivalEvent()
    {
        try
        {
            showSuccess = false;
            showError = false;
            
            repo.Add(Festival);

            if (selectedBands.Any())
            {
                var bandsToAdd = availableBands?.Where(b => selectedBands.Contains(b.Id)).ToList();
                if (bandsToAdd != null)
                {
                    Festival.Bands = bandsToAdd;
                }
            }
            
            if (await repo.SaveAsync())
            {
                showSuccess = true;
                StateHasChanged();
                
                Festival = new Festival() { Location = string.Empty, Name = string.Empty, Description = string.Empty };
                selectedBands.Clear();

                await Task.Delay(1500);
                navigationManager.NavigateTo("/festivals");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding festival: {ex.Message}");
            showError = true;
            StateHasChanged();
        }
    }
}