@page "/add-festival"
@using STime.Entities
@using STime.Interfaces

@inject IRepositoryFestival repo
@inject NavigationManager navigationManager
@inject IRepositoryBand repoBand

<h3>Add Festival</h3>

<MudCard>
    <MudForm Model="@Festival">
        <MudCardContent>
            <MudTextField @bind-Value="Festival.Name" 
                          Immediate="true"
                          Label="Name"></MudTextField>
            <MudTextField @bind-Value="Festival.Location"
                          Immediate="true"
                          Label="Location"></MudTextField>
            
            <MudTextField @bind-Value="Festival.Description"
                          Immediate="true"
                          Label="Description"></MudTextField>
            
            <MudDatePicker @bind-Date="Festival.StartDate" Label="Start date" />
            <MudDatePicker @bind-Date="Festival.EndDate" Label="End date" />
            
            <MudText Typo="Typo.h6" Class="mt-4 mb-2">Select Bands</MudText>
            
            @if (availableBands != null && availableBands.Any())
            {
                <MudSelect T="int" Label="Add Band" @bind-Value="selectedBandId" 
                           Placeholder="Choose a band to add">
                    @foreach (var band in availableBands.Where(b => !selectedBands.Contains(b.Id)))
                    {
                        <MudSelectItem Value="@band.Id">@band.Name (@band.Genre)</MudSelectItem>
                    }
                </MudSelect>
                
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           @onclick="AddBandToFestival"
                           Disabled="@(selectedBandId == 0)"
                           Class="mt-2">
                    Add Band
                </MudButton>
            }
            
            @if (selectedBands.Any())
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-2">Selected Bands</MudText>
                <MudPaper Class="pa-2">
                    @foreach (var bandId in selectedBands)
                    {
                        var band = availableBands?.FirstOrDefault(b => b.Id == bandId);
                        if (band != null)
                        {
                            <div class="d-flex justify-space-between align-center pa-2">
                                <MudText>@band.Name (@band.Genre)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Small"
                                               @onclick="() => RemoveBandFromFestival(bandId)" />
                            </div>
                            <MudDivider />
                        }
                    }
                </MudPaper>
            }
            
            <MudButton Variant="Variant.Filled" @onclick="AddFestivalEvent">Submit</MudButton>
            
            @if (s == true)
            {
                <MudAlert Severity="Severity.Success">Festivalul a fost adaugat cu succes!</MudAlert>
            }
        </MudCardContent>
    </MudForm>
</MudCard>

@code {
    public Festival Festival { get; set; } = new Festival()
    {
        Location = string.Empty,
        Name = string.Empty,
        Description = string.Empty,
        StartDate = null,
        EndDate = null
    };

    private bool s = false;
    private IReadOnlyList<Band>? availableBands;
    private List<int> selectedBands = new List<int>();
    private int selectedBandId = 0;

    protected override async Task OnInitializedAsync()
    {
        availableBands = await repoBand.ListAllAsync();
    }

    private void AddBandToFestival()
    {
        if (selectedBandId > 0 && !selectedBands.Contains(selectedBandId))
        {
            selectedBands.Add(selectedBandId);
            selectedBandId = 0;
        }   
    }

    private void RemoveBandFromFestival(int bandId)
    {
        selectedBands.Remove(bandId);
    }

    private async Task AddFestivalEvent()
    {
        try
        {
            repo.Add(Festival);

            if (selectedBands.Any())
            {
                var bandsToAdd = availableBands?.Where(b => selectedBands.Contains(b.Id)).ToList();
                if (bandsToAdd != null)
                {
                    Festival.Bands = bandsToAdd;
                }
            }
            
            if (await repo.SaveAsync())
                s = true;

            Festival = new Festival() { Location = string.Empty, Name = string.Empty, Description = string.Empty };
            selectedBands.Clear();

            await Task.Delay(1000);
            navigationManager.NavigateTo("/festivals");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding festival: {ex.Message}");
        }
    }
}